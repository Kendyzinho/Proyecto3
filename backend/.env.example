APP_NAME="Gestión de Prácticas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200

APP_LOCALE=es
APP_TIMEZONE=America/Santiago
APP_FAKER_LOCALE=es_ES

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=practicas
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Con "log" los correos no se envían: quedan escritos en storage/logs/laravel.log
MAIL_MAILER=log
MAIL_FROM_ADDRESS="practicas@uta.cl"
MAIL_FROM_NAME="${APP_NAME}"
