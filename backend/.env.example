APP_NAME="Gestión de Prácticas"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:4200

APP_LOCALE=es
APP_TIMEZONE=America/Santiago
APP_FAKER_LOCALE=es_ES

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=practicas
DB_USERNAME=root
DB_PASSWORD=

QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Con "log" los correos no se envían: quedan escritos en storage/logs/laravel.log
# Para enviarlos de verdad con Gmail: MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587,
# MAIL_USERNAME=tu correo, MAIL_PASSWORD=contraseña de aplicación de Google (no la clave normal)
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="practicas@uta.cl"
MAIL_FROM_NAME="${APP_NAME}"
# En desarrollo, todos los correos llegan a esta dirección (vacía = a los destinatarios reales)
MAIL_SIEMPRE_A=
